# Database
DB_HOST=db
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=document_creator

# CORS (comma-separated origins)
CORS_ORIGIN=http://localhost:4200

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRATION=1h

# MinIO
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false

# n8n
N8N_ENCRYPTION_KEY=change-me-in-production

# ── Managed by hassan-devkit (slot 0) — do not edit by hand ──
# Profiles: hassan-devkit worktree:profiles add|remove <api>.
# Image tag: recomputed by hassan-devkit worktree:env (pnpm docker:dev:up runs it).
COMPOSE_PROJECT_NAME=document-creator
COMPOSE_PROFILES=api
DEVKIT_IMAGE_TAG=latest
DEVKIT_SLOT=0
DEVKIT_BRANCH=main
DEVKIT_PORT_API=3000
DEVKIT_PORT_DB=5432
DEVKIT_PORT_MAILPIT=8025
DEVKIT_PORT_MINIO=9000
DEVKIT_PORT_MINIO_CONSOLE=9001
DEVKIT_PORT_N8N=5678
DEVKIT_PORT_PGADMIN=5050
DEVKIT_PORT_SMTP=1025
DEVKIT_PORT_WEB=4200
FRONTEND_URL=http://localhost:4200
API_PROXY_TARGET=http://localhost:3000
