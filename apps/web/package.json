{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "nx": {
    "implicitDependencies": [
      "theme"
    ]
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "lint": "ng lint",
    "check-translations": "hassan-devkit i18n:check",
    "format": "prettier --write \"src/**/*.{ts,html,scss,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss,css,json}\""
  },
  "dependencies": {
    "@angular/animations": "^22.2.3",
    "@angular/cdk": "^22.2.3",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@larscom/ngx-translate-module-loader": "^5.1.0",
    "@ngrx/operators": "^22.0.1",
    "@ngrx/signals": "^22.0.1",
    "@ngx-translate/core": "^17.0.0",
    "@primeuix/themes": "^3.0.1",
    "gridstack": "^14.0.0",
    "primeicons": "^8.0.2",
    "primeng": "^22.1.2",
    "quill": "^2.0.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.1.0",
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.3",
    "@coding-with-hassan/devkit": "^1.4.0",
    "@coding-with-hassan/eslint-config-spa": "^0.4.0",
    "@coding-with-hassan/prettier-config-spa": "^0.1.0",
    "@tailwindcss/postcss": "^4.1.12",
    "eslint": "^10.3.0",
    "postcss": "^8.5.3",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.1.12",
    "typescript": "~6.0.3"
  }
}
